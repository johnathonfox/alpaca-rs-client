flowchart LR
    subgraph alpaca-rs
        lib[lib.rs<br/>public exports]
        subgraph infra [shared infrastructure]
            cred[Credentials<br/>API key / OAuth bearer]
            rest[RestClient<br/>auth, pagination, retry]
            err[Error / Result]
        end
        subgraph trading [trading/]
            tc[TradingClient<br/>orders incl. multi-leg, positions,<br/>account, activities, assets,<br/>locates, watchlists, ...]
        end
        subgraph data [data/]
            stock[StockHistoricalDataClient]
            crypto[CryptoHistoricalDataClient]
            option[OptionHistoricalDataClient]
            news[NewsClient]
            screen[ScreenerClient]
            ca[CorporateActionsClient]
            fx[ForexClient]
            logo[LogoClient<br/>image bytes, not JSON]
        end
        subgraph stream [stream/]
            mds[MarketDataStream<br/>stocks / crypto / options / news]
            ts[TradingStream<br/>trade_updates]
            sse[EventStream + SseParser<br/>ActivityEventsClient,<br/>CorporateActionEventsClient]
        end
    end

    tc -->|REST /v1 /v2 /v3| tapi[api / paper-api<br/>.alpaca.markets]
    stock & crypto & option & news & screen & ca & fx & logo -->|REST| dapi[data.alpaca.markets]
    mds -->|WSS JSON| sdata[stream.data.alpaca.markets]
    ts -->|WSS JSON| tapi
    sse -->|SSE /v2beta1/events/activities| tapi
    sse -->|SSE /v1beta1/events/corporate-actions| dapi

    lib --> trading & data & stream
    trading & data --> infra
    stream --> cred
    stream --> err

# Alpaca API credentials (paper-trading keys work for examples and tests).
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored — never commit real keys.
#
# Load into your shell before running the example:
#   set -a; source .env; set +a
#   cargo run --example quickstart
# (Credentials::from_env() reads process env vars; the file itself is not
# auto-loaded by the crate.)

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
